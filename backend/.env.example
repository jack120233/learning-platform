# 在线学习平台环境变量配置模板
# 复制此文件为 .env 并修改相应配置

# 应用配置
APP_NAME=在线学习平台
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
# MySQL (本项目使用)
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/learning_platform
# PostgreSQL (备选)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/learning_platform
# SQLite (开发测试)
# DATABASE_URL=sqlite+aiosqlite:///./data/learning_platform.db
DATABASE_ECHO=false

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT 配置
# 生产环境必须修改为随机生成的强密钥
JWT_SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30

# 密码加密配置
BCRYPT_ROUNDS=12

# 验证码配置
CAPTCHA_EXPIRE_MINUTES=5
EMAIL_CODE_EXPIRE_MINUTES=10

# 登录安全配置
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# CORS 配置（多个源用逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080