APP_EDITION=windows_classroom
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
CACHE_BACKEND=auto
SQLITE_BUSY_TIMEOUT_MS=30000

# Leave DATABASE_URL unset so the backend uses its Windows classroom SQLite file.
# Runtime data defaults:
# - database: project_code/backend/data/windows-classroom.db
# - cache: project_code/backend/data/cache/
# - uploads: project_code/backend/uploads/
# - logs: project_code/backend/logs/
