APP_EDITION=windows_local
ENVIRONMENT=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
CACHE_BACKEND=auto

# Leave DATABASE_URL unset so the backend uses its Windows local SQLite file.
# Runtime data defaults:
# - database: project_code/backend/data/windows-local.db
# - cache: project_code/backend/data/cache/
# - uploads: project_code/backend/uploads/
# - logs: project_code/backend/logs/
